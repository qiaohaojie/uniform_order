# ==============================================================================
# UNIFORM ORDER PLATFORM - PRODUCTION ENVIRONMENT (.env.prod.example)
# Use this reference template when configuring Environment Variables in
# Hostinger hPanel -> Advanced -> Node.js -> Environment Variables.
# Reference: docs/Deployment/PRODUCTION_DEPLOYMENT.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Neon Postgres - Sydney ap-southeast-2)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. NEON AUTHENTICATION (Production)
# ------------------------------------------------------------------------------
NEON_AUTH_BASE_URL=https://auth.uniformorder.online
NEON_AUTH_COOKIE_SECRET=64_char_random_hex_string_generate_via_openssl_rand_hex_32

# ------------------------------------------------------------------------------
# 3. APPLICATION & ACCESS CONTROL (Production)
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://uniformorder.online
PLATFORM_ADMIN_EMAILS=support@pimspace.com,admin@uniformorder.online

# ------------------------------------------------------------------------------
# 4. STRIPE PAYMENT PROCESSING (Live Mode)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_APPLICATION_FEE_BPS=0

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Emailit Production)
# ------------------------------------------------------------------------------
EMAILIT_API_KEY=em_live_...
FROM_EMAIL="Uniform Online <support@pimspace.com>"

# ------------------------------------------------------------------------------
# 6. ASSET STORAGE (UploadThing Production)
# ------------------------------------------------------------------------------
UPLOADTHING_TOKEN=eyJ...

# ------------------------------------------------------------------------------
# 7. PRODUCT ANALYTICS & TELEMETRY (PostHog Production)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SERVER_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com
