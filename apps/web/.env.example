# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://your-neon-auth-host
NEON_AUTH_COOKIE_SECRET=replace-with-32-byte-random

# Platform admin allowlist (comma-separated emails)
PLATFORM_ADMIN_EMAILS=admin@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_APPLICATION_FEE_BPS=0

# PostHog (product analytics + error tracking)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SERVER_KEY=phx_...
POSTHOG_HOST=https://us.i.posthog.com

# Emailit (transactional email)
EMAILIT_API_KEY=em_...
FROM_EMAIL="Uniform Shop <noreply@example.com>"
