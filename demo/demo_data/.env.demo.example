# UniformOrder demo seed environment
# Copy to .env.demo and fill in the values for your local/dev DB.
# .env.demo is gitignored — never commit real credentials.
#
#   cp demo/demo_data/.env.demo.example demo/demo_data/.env.demo

# Required: same Neon/dev DATABASE_URL as apps/web/.env.local (recommended).
# Localhost and *.neon.tech hosts are allowed by default.
# Production Neon project is always blocked. Other remotes need --allow-remote.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-2.aws.neon.tech/neondb?sslmode=require

# Demo accounts (must be created manually in Neon Auth UI first — see operator_run_guide.md).
# Passwords are for your notes only; the seed does not create auth users.
DEMO_OPERATOR_EMAIL=operator@demo.uniformorder.online
DEMO_OPERATOR_PASSWORD=DemoPass123!
DEMO_PARENT_EMAIL=parent@demo.uniformorder.online
DEMO_PARENT_PASSWORD=DemoPass123!
DEMO_PLATFORM_ADMIN_EMAIL=platformadmin@demo.uniformorder.online
DEMO_PLATFORM_ADMIN_PASSWORD=DemoPass123!

# Optional: if set, the first 3 orders per tenant with orders get orders.user_id = this UUID
# so parent portal /orders history is attributable by user id as well as email.
# Find this UUID in the Neon Auth dashboard after creating parent@demo.uniformorder.online.
DEMO_PARENT_USER_ID=

# Optional: override the base URL used by Playwright recording.
DEMO_BASE_URL=http://localhost:3000
